  m_Text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E, \u0418\u0432\u0430\u043D!\n\u0417\u0430
    \u0442\u0432\u043E\u044E \u0434\u043E\u0431\u043B\u0435\u0441\u0442\u044C \u0438
    \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u044C \u0420\u0443\u0441\u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0439
    \u044D\u0442\u043E\u0442 \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0439 \u0434\u0430\u0440.\n\u041F\u0443\u0441\u0442\u044C
    \u043E\u043D \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435
    \u0432 \u0433\u0440\u044F\u0434\u0443\u0449\u0438\u0445 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F\u0445."
