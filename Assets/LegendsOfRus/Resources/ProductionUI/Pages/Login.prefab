    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041E\u043D\u043B\u0430\u0439\u043D-\u0432\u0445\u043E\u0434 \u0438 \u043F\u0440\u0438\u0432\u044F\u0437\u043A\u0430
    \u0430\u043A\u043A\u0430\u0443\u043D\u0442\u0430 \u043F\u043E\u043A\u0430 \u043D\u0435
    \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u044B. \u0414\u0430\u043D\u043D\u044B\u0435
    \u043D\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435
    \u043A\u0430\u043A \u0433\u043E\u0441\u0442\u044C: \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430
    \u044D\u0442\u043E\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0435."
