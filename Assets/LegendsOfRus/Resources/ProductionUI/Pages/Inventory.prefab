  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.9529412, g: 0.80784315, b: 0.5372549, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 0d1840af9515a75089c5c81fd52eca83, type: 3}
    m_FontSize: 30
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 23
    m_MaxSize: 30
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u042D\u0442\u043E \u043F\u0440\u0438\u043C\u0435\u0440 \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430, \u0430 \u043D\u0435 \u0432\u0435\u0449\u044C
    \u0432 \u0432\u0430\u0448\u0435\u043C \u0432\u043B\u0430\u0434\u0435\u043D\u0438\u0438.
    \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E, \u0440\u0435\u0446\u0435\u043F\u0442\u044B,
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0437\u0430\u0434\u0430\u043D\u0438\u0439
    \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435 \u043F\u043E\u043A\u0430
    \u043D\u0435 \u0440\u0435\u0430\u043B\u0438\u0437\u043E\u0432\u0430\u043D\u044B.
    \u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B
