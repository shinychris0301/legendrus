  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 0d1840af9515a75089c5c81fd52eca83, type: 3}
    m_FontSize: 29
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 23
    m_MaxSize: 29
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041F\u0438\u0441\u044C\u043C\u0430, \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u0438
    \u0438 \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u044B
    \u043A\u0430\u043A \u043F\u0440\u0438\u043C\u0435\u0440\u044B \u0434\u0438\u0437\u0430\u0439\u043D\u0430.\n\n\u041E\u0442\u043F\u0440\u0430\u0432\u043A\u0430
    \u0438 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u043F\u0438\u0441\u0435\u043C,
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0439
    \u0438 \u0441\u0431\u043E\u0440 \u0432\u0441\u0435\u0445 \u043D\u0430\u0433\u0440\u0430\u0434
    \u0431\u0443\u0434\u0443\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B
    \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u043F\u043E\u0447\u0442\u044B. \u041D\u0430\u0433\u0440\u0430\u0434\u044B \u0438
    \u0432\u0430\u043B\u044E\u0442\u0430 \u043D\u0435 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u044E\u0442\u0441\u044F.\n\n\u041C\u043E\u0436\u043D\u043E
    \u043F\u0440\u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
    \u043F\u0440\u0438\u043C\u0435\u0440\u044B \u043F\u0438\u0441\u0435\u043C \u0438
    \u0432\u043A\u043B\u0430\u0434\u043A\u0438."
