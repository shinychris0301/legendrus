{
  "schemaVersion": 3,
  "milestone": "v1.20-step07.3-reference-accurate-wave1-typography",
  "policy": {
    "runtimeLocalizedText": "live UnityEngine.UI.Text",
    "fontBinaryBundled": false,
    "productionFontSlot": "Assets/LegendsOfRus/Art/Fonts/Production",
    "developmentFallback": "LegacyRuntime.ttf",
    "staticDecorativeLettering": "game logo / authored emblem lettering may remain raster art"
  },
  "styles": {
    "displayGold": {
      "usage": "major page titles and primary CTA labels",
      "color": "#F4CD77",
      "fontStyle": "Bold",
      "outline": "#401C09 @ 2px",
      "shadow": "black 55% @ +1,-2"
    },
    "headingGold": {
      "usage": "section headings / navigation labels",
      "color": "#EDCB84",
      "fontStyle": "Bold",
      "outline": "#32190A @ 2px",
      "shadow": "black 55% @ +1,-2"
    },
    "hud": {
      "usage": "currency, energy, score, moves and compact status text",
      "color": "#F4E0B4",
      "fontStyle": "Normal",
      "outline": "#0F1217 @ 1px"
    },
    "bodyDark": {
      "usage": "parchment dialogue / tips",
      "color": "#492D1B",
      "fontStyle": "Normal",
      "outline": "none"
    },
    "bodyLight": {
      "usage": "dark-panel body copy",
      "color": "#EFDAB0",
      "fontStyle": "Normal",
      "outline": "#141414 @ 1px"
    }
  },
  "signoffRule": "Typography pipeline is final. Release-font face remains an externally licensed import and must be reviewed in Unity before active cutover."
}
