+using UnityEngine;
+using UnityEngine.UI;
+
+namespace LegendsOfRus
+{
+    /// <summary>Victory-only raised gold rim, recessed outline and alternating face facets.</summary>
+    [DisallowMultipleComponent]
+    public sealed class ProductionVictoryStarDepth : BaseMeshEffect
+    {
+        public override void ModifyMesh(VertexHelper vh)
+        {
+            var star=graphic as ProductionWorldMapGraphic;
+            if(!IsActive()||star==null||star.Kind!=WorldMapGraphicKind.Star)return;
+            vh.Clear();Rect rect=star.GetPixelAdjustedRect();Vector2 center=rect.center;
+            float radius=Mathf.Min(rect.width,rect.height)*.48f;
+            Color dark=new Color32(58,26,4,255),gold=new Color32(214,132,20,255);
+            Color light=new Color32(255,243,169,255),edge=new Color32(255,199,53,255);
+            for(int i=0;i<10;i++)
+            {
+                Vector2 a=Point(i,radius),b=Point(i+1,radius);
+                // Downward cast edge, outside bevel, narrow luminous lip, then inner bevel.
+                Tri(vh,center+new Vector2(0,-3),center+a+new Vector2(0,-3),center+b+new Vector2(0,-3),dark,dark,dark);
+                Ring(vh,center,a,b,1,.91f,dark,edge);
+                Ring(vh,center,a,b,.91f,.86f,light,edge);
+                Ring(vh,center,a,b,.86f,.72f,i%2==0?light:gold,i%2==0?gold:dark);
+                if(star.Dimmed)
+                {
+                    Color recess=new Color32(17,21,25,255);
+                    Tri(vh,center,center+a*.72f,center+b*.72f,recess,recess,recess);
+                }
+                else
+                {
+                    Color face=i%2==0?new Color32(255,218,87,255):new Color32(223,141,20,255);
+                    Tri(vh,center,center+a*.72f,center+b*.72f,light,face,i%2==0?gold:face);
+                }
+            }
+        }
+        static void Ring(VertexHelper vh,Vector2 c,Vector2 a,Vector2 b,float outer,float inner,Color outside,Color inside)
+        {
+            Tri(vh,c+a*outer,c+b*outer,c+b*inner,outside,outside,inside);
+            Tri(vh,c+b*inner,c+a*inner,c+a*outer,inside,inside,outside);
+        }
+        static Vector2 Point(int i,float radius)
+        {
+            float angle=Mathf.PI*.5f+i*Mathf.PI/5;return new Vector2(Mathf.Cos(angle),Mathf.Sin(angle))*radius*(i%2==0?1:.44f);
+        }
+        static void Tri(VertexHelper vh,Vector2 a,Vector2 b,Vector2 c,Color ca,Color cb,Color cc)
+        {
+            int n=vh.currentVertCount;vh.AddVert(a,ca,Vector2.zero);vh.AddVert(b,cb,Vector2.zero);vh.AddVert(c,cc,Vector2.zero);vh.AddTriangle(n,n+1,n+2);
+        }
+    }
+}
