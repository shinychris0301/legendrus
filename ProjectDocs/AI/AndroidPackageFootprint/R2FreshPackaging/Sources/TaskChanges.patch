+    for relative in GENERATED:
+        source = ROOT / relative
+        if source.exists():
+            target = LOGS / 'Before' / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(source, target)
+
+    record = run('PolicyTests', ['-runTests', '-testPlatform', 'EditMode',
+        '-testFilter', 'LegendsOfRus.Tests.AndroidBuild;LegendsOfRus.Tests.ContentDelivery',
+        '-testResults', str(QA / 'PolicyTests/results.xml')])
+    result = record['result']
+    assert result['result'] == 'Passed' and int(result['passed']) > 0 and result['skipped'] == '0'
+    require_idle()
+    policy = json.loads((ROOT / 'Assets/LegendsOfRus/Editor/AndroidBuild/Config/android_build_foundation_policy.json').read_text())
+    apk = ROOT / policy['developmentOutputRelativePath']
+    prior = json.loads((BASE.parent / 'R1/QA/Summary.json').read_text())
+    digest = sha(apk)
+    assert digest == prior['sha256'], 'Artifact differs from the audited baseline'
+    archive = apk.parent / 'BeforeFreshPackagingR2'
