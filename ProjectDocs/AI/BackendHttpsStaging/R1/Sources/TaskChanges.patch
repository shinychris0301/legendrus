+[Unit]
+Description=Legends of Rus isolated session staging
+After=network.target
+
+[Service]
+User=lor-staging
+Group=lor-staging
+WorkingDirectory=/opt/lor-staging/current
+Environment=PYTHONDONTWRITEBYTECODE=1
+EnvironmentFile=/etc/lor-staging/config
+StateDirectory=lor-staging
+StateDirectoryMode=0700
+UMask=0077
+ExecStart=/opt/lor-staging/venv/bin/gunicorn --config deploy/gunicorn.conf.py staging:create_app()
+Restart=on-failure
+RestartSec=5
+TimeoutStopSec=40
+NoNewPrivileges=true
+PrivateTmp=true
+PrivateDevices=true
+ProtectSystem=strict
+ProtectHome=true
+ProtectKernelTunables=true
+ProtectKernelModules=true
+ProtectControlGroups=true
+RestrictSUIDSGID=true
+RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
+CapabilityBoundingSet=
+ReadWritePaths=/var/lib/lor-staging
+
+[Install]
+WantedBy=multi-user.target
