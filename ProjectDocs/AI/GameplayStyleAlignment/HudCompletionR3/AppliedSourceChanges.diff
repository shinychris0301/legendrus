+using UnityEngine;
+using UnityEngine.UI;
+namespace LegendsOfRus
+{
+    /// <summary>R3 upgrade of the existing serialized HUD; all controls and board mounts retain identity.</summary>
+    public static class ProductionGameplayHudStyle
+    {
+        public static void Apply(ProductionGameplayView v)
+        {
+            Image header=v.Hud.Find("HudPanel").GetComponent<Image>();
+            header.sprite=ProductionGameplayArt.Load("hud_header_r3"); Place(header.rectTransform,0,-24,941,268);
+            Image footer=v.Footer.Find("ScorePanel").GetComponent<Image>();
+            footer.sprite=ProductionGameplayArt.Load("score_panel_r3"); Place(footer.rectTransform,0,170,941,194);
+            // The generated footer includes its intentionally opaque, recessed score well.
+            v.Footer.Find("ScoreInset").GetComponent<ProductionGameplayCell>().enabled=false;
+            var portraitFrame=v.Hud.Find("IvanFrame").GetComponent<RectTransform>();Place(portraitFrame,0,-4,238,284);
+            var clip=v.Hud.Find("PortraitClip").GetComponent<ProductionHomePanel>();Place(clip.rectTransform,28,24,184,184);clip.Radius=92;
+            Place(clip.transform.Find("IvanPortrait").GetComponent<RectTransform>(),0,0,184,184);
+            Text(v.HeroName,231,26,160,42,32,false,TextAnchor.MiddleLeft);
+            Text(v.LevelText,232,69,174,34,23,false,TextAnchor.MiddleLeft);
+            Place(v.Hud.Find("GoalProgressFrame").GetComponent<RectTransform>(),232,110,174,24);
+            Place(v.GoalProgress.rectTransform,240,118,158,9);
+            Place(v.Hud.Find("StarProgressFrame").GetComponent<RectTransform>(),393,49,197,25);
+            Place(v.StarProgress.rectTransform,401,57,181,9);
+            for(int i=0;i<3;i++)Place(v.Stars[i].rectTransform,402+i*76,29,44,46);
+            Place(v.Hud.Find("MovesMedallion").GetComponent<RectTransform>(),372,70,242,215);
+            Text(v.MovesHeading,401,109,181,38,25,false);
+            Text(v.MovesValue,399,135,186,92,85,false);
+            Text(v.GoalsHeading,626,24,251,39,31,false);
+            Place(v.Hud.Find("GoalPanel").GetComponent<RectTransform>(),625,72,255,117);
+            Place(v.Hud.Find("GoalLacquer").GetComponent<RectTransform>(),625,72,255,117);
+            for(int i=0;i<2;i++)
+            {
+                var g=v.Goals[i];Place(g.Root,630+i*126,76,118,110);Place(g.Icon.rectTransform,4,1,86,96);
+                Text(g.Count,57,65,61,39,29,false);
+                g.Description.enabled=false;
+                var found=g.Root.Find("GoalSymbol");
+                g.Symbol=found!=null?found.GetComponent<ProductionGameplayGoalSymbol>():ProductionGameplayRuntime.Rect(g.Root,"GoalSymbol",22,19,50,58).gameObject.AddComponent<ProductionGameplayGoalSymbol>();
+                g.Symbol.raycastTarget=false;g.Symbol.enabled=false;
+            }
+            for(int i=0;i<4;i++)
+            {
+                // Retain every supplied medallion's texture and interactive bounds.
+                var badge=v.BoosterCounts[i].transform.parent.GetComponent<RectTransform>();Place(badge,125,135,54,54);
+                Text(v.BoosterCounts[i],0,-1,54,54,36,true);
+                v.BoosterCounts[i].resizeTextForBestFit=true;v.BoosterCounts[i].resizeTextMinSize=32;v.BoosterCounts[i].resizeTextMaxSize=72;
+            }
+            v.PauseButton.GetComponent<Image>().sprite=ProductionGameplayArt.Load("pause_gear_r3");
+            Place(v.PauseButton.GetComponent<RectTransform>(),835,65,95,100);
+            Text(v.ScoreHeading,305,216,331,35,28,false);
+            Text(v.ScoreValue,245,257,451,61,51,false);
+            EnsureStatus(v);
+            v.Revision=ProductionGameplayView.CurrentRevision;
+        }
+        static void EnsureStatus(ProductionGameplayView v)
+        {
