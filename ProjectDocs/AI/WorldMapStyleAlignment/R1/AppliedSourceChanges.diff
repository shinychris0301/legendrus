+                Color ca=Direction(light,dark,a),cb=Direction(light,dark,b);
+                Tri(vh,c+a*outer,c+b*outer,c+b*inner,ca,cb,cb);Tri(vh,c+b*inner,c+a*inner,c+a*outer,cb,ca,ca);
