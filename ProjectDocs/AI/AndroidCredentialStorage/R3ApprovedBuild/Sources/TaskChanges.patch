+using System;
+using System.IO;
+using System.Security.Cryptography;
+
+namespace LegendsOfRus.AndroidBuild
+{
+    // Exact reviewed source-plugin inventory. Never a general Java/plugin exemption.
+    internal static class ReviewedAndroidCredentialPlugins
+    {
+        static readonly string[] Paths =
+        {
+            "Assets/LegendsOfRus/Plugins/AndroidCredentials/CredentialVault.java",
+            "Assets/LegendsOfRus/Plugins/AndroidCredentials/CredentialVault.java.meta",
+            "Assets/LegendsOfRus/Plugins/AndroidCredentials/AndroidCredentialBridge.java",
+            "Assets/LegendsOfRus/Plugins/AndroidCredentials/AndroidCredentialBridge.java.meta",
+        };
+        static readonly string[] Hashes =
+        {
+            "a1b82cddc35ad78953836d57476bf0d05bd23e36c3c8b97eb84618b02e84b9a1",
+            "7db80273fd38288024482db159386f648fa19e902bfb3348c6802bcc639d6c46",
+            "dc50fbcd8b7b4288b1edc908dd9fc50e360cf0ba8cff3b6f5b8e2c1914e5bc7d",
+            "b2c2d92d7a99fdd2df674daa76d60df1a11326fd650f0d453d171853da8e7db6",
+        };
+
+        internal static bool IsAllowed(string root, string candidate)
+        {
+            if (string.IsNullOrEmpty(root) || string.IsNullOrEmpty(candidate))
+                return false;
+            try
+            {
+                string absoluteRoot = Path.GetFullPath(root);
+                string absoluteCandidate = Path.GetFullPath(candidate);
+                bool isReviewedSource = false;
+                for (int i = 0; i < Paths.Length; i += 2)
+                    isReviewedSource |= string.Equals(absoluteCandidate,
+                        Path.GetFullPath(Path.Combine(absoluteRoot, Paths[i])),
+                        StringComparison.Ordinal);
+                if (!isReviewedSource)
+                    return false;
+
+                // Both Java files AND Android-only importer metadata must match.
+                for (int i = 0; i < Paths.Length; i++)
+                {
+                    using (var stream = File.OpenRead(Path.Combine(absoluteRoot, Paths[i])))
+                    using (var sha = SHA256.Create())
+                    {
+                        string actual = BitConverter.ToString(sha.ComputeHash(stream))
+                            .Replace("-", "").ToLowerInvariant();
+                        if (!string.Equals(actual, Hashes[i], StringComparison.Ordinal))
+                            return false;
+                    }
+                }
+                return true;
+            }
+            catch (IOException) { return false; }
+            catch (UnauthorizedAccessException) { return false; }
+            catch (ArgumentException) { return false; }
+            catch (NotSupportedException) { return false; }
+            catch (System.Security.SecurityException) { return false; }
+            catch (CryptographicException) { return false; }
+        }
+    }
+}
