{
  "id": "model_openai-gpt-image-2",
  "name": "GPT Image 2",
  "status": "trained",
  "capabilities": [
    "txt2img",
    "img2img"
  ],
  "inputs": [
    {
      "description": "Text description of desired generation or edit.",
      "label": "Prompt",
      "maxLength": 32000,
      "name": "prompt",
      "costImpact": false,
      "prompt": true,
      "required": {
        "always": true
      },
      "type": "string",
      "promptSpark": true
    },
    {
      "description": "Reference images for editing. Each image must be under 50 MB.",
      "kind": "image",
      "label": "Reference Images",
      "maxLength": 10,
      "maxSize": 52428800,
      "name": "referenceImages",
      "costImpact": true,
      "parent": true,
      "required": {
        "ifDefined": {
          "mask": {
            "message": "A reference image is required when a mask is provided."
          }
        }
      },
      "type": "file_array"
    },
    {
      "backgroundBehavior": "transparent",
      "description": "PNG mask for inpainting, same dimensions as the first reference image. OpenAI uses the alpha channel only: fully transparent pixels are edited, fully opaque pixels are preserved. RGB white/black is ignored if there is no alpha. Export PNG with transparency \u2014 do not flatten. If you paint a white-on-black mask, convert the white (edit) region to transparent.",
      "kind": "image",
      "label": "Mask",
      "maxSize": 52428800,
      "name": "mask",
      "costImpact": false,
      "parent": true,
      "type": "file",
      "maskFrom": "referenceImages"
    },
    {
      "description": "Number of images to generate",
      "default": 1,
      "group": "Settings",
      "label": "Image Count",
      "max": 10,
      "min": 1,
      "name": "numOutputs",
      "costImpact": true,
      "step": 1,
      "type": "number"
    },
    {
      "description": "Output width in pixels.",
      "group": "Settings",
      "label": "Width",
      "max": 3840,
      "min": 16,
      "name": "width",
      "costImpact": true,
      "step": 16,
      "type": "number"
    },
    {
      "description": "Output height in pixels.",
      "group": "Settings",
      "label": "Height",
      "max": 3840,
      "min": 16,
      "name": "height",
      "costImpact": true,
      "step": 16,
      "type": "number"
    },
    {
      "allowedValues": [
        "auto",
        "high",
        "medium",
        "low"
      ],
      "description": "Generation quality",
      "default": "auto",
      "group": "Settings",
      "label": "Quality",
      "name": "quality",
      "costImpact": true,
      "type": "string"
    },
    {
      "allowedValues": [
        "auto",
        "opaque",
        "transparent"
      ],
      "description": "Background option. Transparent is in Preview.",
      "default": "auto",
      "group": "Settings",
      "label": "Background",
      "name": "background",
      "costImpact": false,
      "type": "string"
    }
  ]
}
