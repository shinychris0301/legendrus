+        static void ImportHomeAlignmentArt()
+        {
+            // Only the seven newly approved Home files are owned here. Shared Splash art,
+            // typography and the small existing currency glyph importers stay untouched.
+            foreach (string name in HomeAlignmentArtNames)
+            {
+                string path = "Assets/LegendsOfRus/Resources/" + ProductionHomeRuntime.ArtRoot + name + ".png";
+                if (!File.Exists(path)) throw new FileNotFoundException("Missing reviewed Home layer.", path);
+                AssetDatabase.ImportAsset(path, ImportAssetOptions.ForceSynchronousImport);
+                TextureImporter importer = AssetImporter.GetAtPath(path) as TextureImporter;
+                if (importer == null) throw new InvalidOperationException("Home layer has no texture importer: " + path);
+                importer.textureType = TextureImporterType.Sprite;
+                importer.spriteImportMode = SpriteImportMode.Single;
+                importer.spritePixelsPerUnit = 100f;
+                importer.npotScale = TextureImporterNPOTScale.None;
+                importer.maxTextureSize = 2048;
+                bool minifiedControl = name != "home_environment_generated";
+                importer.mipmapEnabled = minifiedControl;
+                importer.mipmapFilter = TextureImporterMipFilter.BoxFilter;
+                importer.sRGBTexture = true;
+                importer.isReadable = false;
+                importer.textureCompression = TextureImporterCompression.Uncompressed;
+                importer.wrapMode = TextureWrapMode.Clamp;
+                importer.filterMode = minifiedControl ? FilterMode.Trilinear : FilterMode.Bilinear;
+                importer.alphaSource = TextureImporterAlphaSource.FromInput;
+                importer.alphaIsTransparency = name == "nav_map_generated" ||
+                    name == "nav_events_generated" || name == "mail_medallion_generated";
+                TextureImporterSettings settings = new TextureImporterSettings();
+                importer.ReadTextureSettings(settings);
+                settings.spriteMeshType = SpriteMeshType.FullRect;
+                settings.spriteGenerateFallbackPhysicsShape = false;
+                importer.SetTextureSettings(settings);
+                importer.SaveAndReimport();
+            }
+        }
