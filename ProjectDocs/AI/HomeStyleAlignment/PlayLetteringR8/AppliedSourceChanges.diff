+        [PerRendererData] _MainTex ("Font atlas", 2D) = "white" {}
+        _Color ("Tint", Color) = (1,1,1,1)
+        _Highlight ("Bevel highlight", Color) = (1,0.94,0.68,1)
+        _Recess ("Bevel recess", Color) = (0.30,0.13,0.025,1)
