+        static void AssertHeroLowerFadeMesh(ProductionHomeView view)
+        {
+            SplashTitleCharacterFade fade = view.Ivan.GetComponent<SplashTitleCharacterFade>();
+            Assert.That(fade != null && fade.enabled, Is.True);
